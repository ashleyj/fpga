IO_LOC "clk" 52;
IO_PORT "clk"  PULL_MODE=UP;

// --- reset button (s1) ---
IO_LOC "reset" 4;
IO_PORT "reset" PULL_MODE=DOWN;

// --- led[3:0] on 4 of the onboard LEDs ---
IO_LOC "led[0]" 10;
IO_PORT "led[0]" PULL_MODE=DOWN DRIVE=8;
IO_LOC "led[1]" 11;
IO_PORT "led[1]" PULL_MODE=DOWN DRIVE=8;
IO_LOC "led[2]" 13;
IO_PORT "led[2]" PULL_MODE=DOWN DRIVE=8;
IO_LOC "led[3]" 14;
IO_PORT "led[3]" PULL_MODE=DOWN DRIVE=8;
